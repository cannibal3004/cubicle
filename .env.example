# Copy to .env before `docker compose up`. Accounts are created in the browser on first start.


# Address browsers use to reach the stack. Caddy only answers requests whose
# Host matches this exactly (port excluded), so open the site with the same
# hostname or IP you put here.
#   https://<hostname-or-lan-ip>  TLS from Caddy's internal CA (trust its root cert on clients)
#   http://<hostname-or-lan-ip>   plain HTTP; also set AUTH_COOKIE_SECURE=0
# Several addresses, comma-separated, serve the same site under each, e.g. the LAN IP and the
# hostname a tunnel or front proxy uses: https://192.168.1.10, https://cubicle.example.com
# Put the LAN IP first: browsers opening a bare IP send no hostname, and the first address
# is the certificate they get.
SITE_ADDRESS=https://localhost
HTTP_PORT=80
HTTPS_PORT=443
AUTH_COOKIE_SECURE=1

# LLM defaults. Optional; App Settings in the UI can set and change all of these.
LLM_PROVIDER=openai_compatible
LLM_API_KEY=
# A model server running on the Docker host itself: http://host.docker.internal:8080/v1
LLM_BASE_URL=
DEFAULT_MODEL=
LLM_REASONING_EFFORT=
# Sent as max_tokens when set. 0 leaves the server's default (some local
# servers stop at 8192, which cuts a long tool call in half).
LLM_MAX_COMPLETION_TOKENS=0
# Requests in flight at the model server at once, shared fairly between
# accounts; the rest wait in the chat with their place shown. 0 = no limit.
# App Settings > Model server overrides this.
LLM_MAX_CONCURRENT_REQUESTS=4

# Optional connector key for the Marketplace.
# Where persistent data lives. Leave unset for Docker named volumes. Set host
# paths to keep the data with your other appdata (easier backups; on Unraid the
# docker image is small and fixed-size). The API runs as uid 10001, so the
# API_DATA_DIR directory must be writable by that user (chown -R 10001:10001).
# API_DATA_DIR=/mnt/user/appdata/cubicle/data
# CADDY_DATA_DIR=/mnt/user/appdata/cubicle/caddy

COMPOSIO_API_KEY=
# Tools offered to the model for each connected app: only Composio's
# "important" ones by default, at most this many per app.
COMPOSIO_IMPORTANT_TOOLS_ONLY=1
COMPOSIO_TOOLS_PER_TOOLKIT=40

# Auto-approval of tool calls by a decision model (see the README). Optional;
# App Settings in the UI can set and change all of these. Modes: off, shadow
# (score and log, you still decide), on. Start with shadow.
AUTO_APPROVAL=off
# A halogen-flash-server with decider-4b, or any server with POST /v1/systemone.
# On the Docker host itself: http://host.docker.internal:8731
DECIDER_URL=
DECIDER_THRESHOLD=0.2

# Thinking (reasoning effort) per bot and per conversation, or Auto, which
# asks the decision server above to pick light or deep for each message.
# List the levels your model understands; model servers do not report them.
# Qwen3.8 Flash Next: none,low,medium,xhigh (xhigh is its default).
THINKING_LEVELS=none,low,medium,high,xhigh
THINKING_AUTO_LIGHT=low
THINKING_AUTO_DEEP=xhigh
# How the level reaches the model. "field" sends it as reasoning_effort. "hint"
# always sends THINKING_HINT_BASE and adds the level's instruction to the end
# of your message, so changing level does not throw away the model server's
# prompt cache. Use hint with Qwen3.8 Flash Next on halogen-flash-server.
THINKING_STYLE=field
THINKING_HINT_BASE=medium

# The shared folder: a host directory bots and you both see. Bots without a
# computer reach it through the approved shared_folder_* tools; a bot's
# computer has it mounted at /shared when the path is absolute (relative
# paths cannot be passed to the Docker daemon; set
# COMPUTER_DOCKER_HOST_SHARED_DIR to the absolute path in that case).
WORKSPACE_DIR=./workspace
COMPUTER_DOCKER_HOST_SHARED_DIR=

# Computer runtime (browser/terminal sandbox per bot). Off by default.
# To enable, uncomment both lines. This mounts the Docker socket into a
# restricted proxy sidecar; read the README section first.
#COMPUTER_PROVIDER=docker
#COMPOSE_PROFILES=computer
# Workspace per computer: "volume" (named Docker volume, works everywhere) or
# "bind" (a host directory). For bind, also set the host path that is mounted
# at /data/computers in the api service.
COMPUTER_DOCKER_WORKSPACE_MODE=volume

# Context management: compact the thread (summarize all but the last few
# turns) once the prompt reaches this share of the model's context window,
# and how much of each tool result (and per reply) is kept when stored.
CONTEXT_COMPACT_AT=0.7
CONTEXT_KEEP_RECENT_TOKENS=30000
CONTEXT_TOOL_RESULT_CHARS=4000
CONTEXT_TOOL_RESULTS_MESSAGE_CHARS=24000
# A turn stops calling tools when the prompt passes this share of the window
# and compaction could not make room, or after this many consecutive tool
# rounds that only repeat earlier calls with the same results.
CONTEXT_STOP_AT=0.9
LLM_STALLED_ROUNDS=3
# Size of a bot's notes (its memory across conversations), in characters.
BOT_MEMORY_MAX_CHARS=16000
# Size of a conversation's or project's work notes, in characters. They are shown
# to the bot every turn, so keep them short; detail belongs in files.
BOT_WORK_NOTES_MAX_CHARS=8000
# Items a bot's to-do list may hold.
BOT_TODO_MAX_ITEMS=50
# Seconds a computer terminal command may run by default, the most the model
# may ask for with timeout_seconds, and the page navigation limit.
COMPUTER_DOCKER_COMMAND_TIMEOUT=60
COMPUTER_DOCKER_COMMAND_TIMEOUT_MAX=600
# The computer's screen, WIDTHxHEIGHT. Set when a computer is created; an
# existing computer keeps its size until it is reset.
COMPUTER_DOCKER_SCREEN=1920x1200
# Screenshots handed to the model are scaled to this width when wider (0 =
# full screen). App Settings > Model server overrides it.
COMPUTER_SCREENSHOT_MAX_WIDTH=1280
# Retrieval: long attachments are chunked and embedded on the model server
# (POST /embeddings; POST /rerank when the server has a reranker), and each
# message pulls in the matching passages. Blank model names use the
# server's defaults. App Settings > Model server overrides these.
RETRIEVAL_ENABLED=1
EMBEDDING_MODEL=
RERANK_MODEL=
# When a bot could be offered more tools than this in one round, the
# connected apps' tools are narrowed to the ones that match the message
# (built-in tools always stay). 0 offers everything.
TOOL_SELECTION_MAX=40
# Where a tool that becomes available partway through a conversation (an app
# you name, connect or switch on) goes. "list" adds it to the tool list, which
# sits at the top of the prompt, so the model server reads the whole
# conversation again. "message" keeps the list as it was since the last
# compaction and describes the new tool at the end of your message. Use
# message with Qwen3.8 Flash Next on halogen-flash-server; hosted APIs only
# take calls to tools in the list.
TOOL_ADD_STYLE=list
# The decider, embedding model and reranker run on the model server's NPU,
# which can crash and restart within seconds: attempts per call, the pauses
# between them, and the per-attempt timeout.
NPU_RETRY_ATTEMPTS=3
NPU_RETRY_BACKOFF_SECONDS=1,3
NPU_REQUEST_TIMEOUT_SECONDS=20
COMPUTER_DOCKER_NAVIGATE_TIMEOUT=30
# Scheduled tasks are written in this timezone: an IANA name such as
# America/Chicago. SCHEDULE_TIMEZONE overrides TZ for schedules only.
TZ=UTC
SCHEDULE_TIMEZONE=
COMPUTER_DOCKER_HOST_WORKSPACE_ROOT=
# Optional: absolute host path of a JPEG or PNG to use as the sandbox desktop
# wallpaper instead of the built-in gradient.
COMPUTER_WALLPAPER=
# Sandbox scratch space: /tmp is a tmpfs of this size, wiped at every start.
# The home directory and /workspace are on disk and persist.
COMPUTER_DOCKER_TMP_SIZE=2g
# Seconds one apt install may take (computer_install_packages, and restoring
# a computer's package list when it starts).
COMPUTER_DOCKER_INSTALL_TIMEOUT=600
