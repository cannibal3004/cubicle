# Files that run inside Linux containers keep LF line endings in every checkout,
# including a Windows one with core.autocrlf on: a shell script with CRLF stops at
# "/bin/sh\r: not found" (exit 127) when the image starts.
*.sh text eol=lf
Dockerfile text eol=lf
runtime/** text eol=lf
deploy/Caddyfile text eol=lf
